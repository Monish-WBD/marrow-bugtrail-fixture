.DS_Store
xcuserdata/

# Compiled bytecode. It was committed once, which meant every run of the test
# suite produced spurious diffs and stale .pyc files travelled with the repo.
__pycache__/
*.pyc

# Local-only test fixtures. Never commit CodeSage-format samples to a public repo.
fixtures/codesage/
.build/
fixtures/real-*.json

# Real ticket text and ground truth mined from internal repositories.
.local/

# Credentials belong in ~/.config/bugtrail/env, never here. Ignored anyway, so
# a stray copy cannot be committed by accident.
.env
*.env

